{
  "expo": {
    "name": "CuraPath",
    "slug": "healthnow-mobile",
    "version": "1.0.13",
    "orientation": "portrait",
    "scheme": "healthnow",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bctpvtltd.curapath",
      "buildNumber": "3",
      "icon": "./assets/images/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bctpvtltd.curapath",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#6D5BD0"
      },
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 17,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow CuraPath to use your camera to photograph prescriptions and reports.",
          "photosPermission": "Allow CuraPath to access your photos to upload prescriptions and reports.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow CuraPath to use Face ID to unlock your health records."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#6D5BD0"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6D5BD0",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/icon.png",
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc989c17-46da-4819-bf9d-20f5f48dd5a9"
      }
    },
    "owner": "bc_expo"
  }
}
