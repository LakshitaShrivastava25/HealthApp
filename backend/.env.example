# Copy this file to .env and fill in real values.

# Required unless DJANGO_DEBUG=True. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# True only on your own machine. Production leaves this unset (= off).
DJANGO_DEBUG=False
# The API's host name(s), comma-separated, e.g. healthapp-backend-li7g.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Paste the Neon PostgreSQL connection string here when it's provided.
# Format: postgresql://user:password@host/dbname?sslmode=require
# Leave unset to keep using local SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Where the web app runs. Production — the landing page and the app are one
# site on curapath.in:
#   CORS_ALLOWED_ORIGINS=https://curapath.in,https://www.curapath.in
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The Claude API key lives ONLY here — never in the React frontend.
# Until this is set, ai/claude_service.py returns clearly-marked mock
# responses so the rest of the app is fully testable without it.
ANTHROPIC_API_KEY=

# OCR provider (Google Vision / AWS Textract) — also mocked until set.
OCR_PROVIDER_API_KEY=

# 2Factor.in SMS OTP — copy the API key from 2factor.in → Account Summary.
# Backend only; never put it in the mobile app or web frontend.
TWOFACTOR_API_KEY=
# Sender ID + template name, as mapped under Transactional SMS in 2Factor.
TWOFACTOR_SENDER_ID=CURAPT
TWOFACTOR_TEMPLATE_NAME=CuraPathOTP

# OTP SMS gateway: true -> 2Factor (above), false -> Twilio Verify (below).
# Master OTP mode (admin portal) overrides both.
USE_TWOFACTOR=false
# Master OTP: true -> no SMS, everyone logs in with MASTER_OTP. false -> real SMS via
# Twilio (USE_TWOFACTOR=false) or 2Factor (USE_TWOFACTOR=true). Unset -> admin-portal toggle.
USE_MASTER_OTP=false
# Your own 6 digits. Outside DEBUG the built-in default (555555) is refused,
# and master mode never applies to staff or verified-doctor accounts.
MASTER_OTP=
# Google Play review login: this one number gets no SMS and signs in with
# REVIEWER_OTP (6 digits). Leave empty to turn it off.
REVIEWER_PHONE=
REVIEWER_OTP=

# Twilio Verify — Console home -> Account Info, and Verify -> Services (VA...).
# Fill EITHER the Auth Token OR an API key pair (SK... + secret).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=

# File storage (documents, insurance policies, doctor licences).
# Either the single URL from the Cloudinary dashboard...
CLOUDINARY_URL=
# ...or the three parts:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
