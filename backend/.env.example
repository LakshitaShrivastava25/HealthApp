# Copy this file to .env and fill in real values.

DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Paste the Neon PostgreSQL connection string here when it's provided.
# Format: postgresql://user:password@host/dbname?sslmode=require
# Leave unset to keep using local SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The Claude API key lives ONLY here — never in the React frontend.
# Until this is set, ai/claude_service.py returns clearly-marked mock
# responses so the rest of the app is fully testable without it.
ANTHROPIC_API_KEY=

# OCR provider (Google Vision / AWS Textract) — also mocked until set.
OCR_PROVIDER_API_KEY=

# 2Factor.in SMS OTP — copy the API key from 2factor.in → Account Summary.
# Backend only; never put it in the mobile app or web frontend.
TWOFACTOR_API_KEY=
# Sender ID + template name, as mapped under Transactional SMS in 2Factor.
TWOFACTOR_SENDER_ID=CURAPT
TWOFACTOR_TEMPLATE_NAME=CuraPathOTP

# OTP SMS gateway: true -> 2Factor (above), false -> Twilio Verify (below).
# Master OTP mode (admin portal) overrides both.
USE_TWOFACTOR=false

# Twilio Verify — Console home -> Account Info, and Verify -> Services (VA...).
# Fill EITHER the Auth Token OR an API key pair (SK... + secret).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=

# File storage (documents, insurance policies, doctor licences).
# Either the single URL from the Cloudinary dashboard...
CLOUDINARY_URL=
# ...or the three parts:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
