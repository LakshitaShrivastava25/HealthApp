{
  "expo": {
    "name": "CuraPath",
    "slug": "healthnow-mobile",
    "version": "1.0.9",
    "orientation": "portrait",
    "scheme": "healthnow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bctpvtltd.curapath",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.bctpvtltd.curapath",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#6D5BD0"
      },
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 12,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow CuraPath to use your camera to photograph prescriptions and reports.",
          "photosPermission": "Allow CuraPath to access your photos to upload prescriptions and reports.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#6D5BD0"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6D5BD0",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/icon.png",
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fcc1d7c0-5490-4589-bdb5-cc45f76699e1"
      }
    },
    "owner": "ayushdev14"
  }
}
