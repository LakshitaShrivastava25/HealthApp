{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_PRODUCTION_API": "true",
        "EXPO_PUBLIC_API_URL_PROD": "https://api.curapath.in/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_USE_PRODUCTION_API": "true",
        "EXPO_PUBLIC_API_URL_PROD": "https://api.curapath.in/api"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6820794651",
        "appleTeamId": "53XKYJ62P9"
      }
    }
  }
}
